				"method": "POST",
				"header": [{"key": "Content-Type", "value": "application/json"}],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"rtt_config\": \"vcmts10ms.json\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/packetstorm/start",
					"host": ["{{base_url}}"],
					"path": ["api", "packetstorm", "start"]
				}
			}
		},
		{
			"name": "PacketStorm - Stop",
			"request": {
				"method": "POST",
				"header": [{"key": "Content-Type", "value": "application/json"}],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"rtt_config\": \"vcmts10ms.json\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/packetstorm/stop",
					"host": ["{{base_url}}"],
					"path": ["api", "packetstorm", "stop"]
				}
			}
		},
