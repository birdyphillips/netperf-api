			"name": "Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/health",
					"host": ["{{base_url}}"],
					"path": ["health"]
				}
			}
		},
		{
			"name": "Set Modem IPv6",
			"request": {
				"method": "POST",
				"header": [{"key": "Content-Type", "value": "application/json"}],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"ipv6\": \"{{modem_ipv6}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/config/modem",
					"host": ["{{base_url}}"],
					"path": ["api", "config", "modem"]
				}
			}
		},
		{
			"name": "ByteBlower - Run Test",
			"request": {
				"method": "POST",
				"header": [{"key": "Content-Type", "value": "application/json"}],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"bbp_file\": \"Port_20_example.bbp\",\n  \"scenario\": \"US_Classic_Only\",\n  \"test_group_name\": \"TEST_SCN_RTT_0\",\n  \"iterations\": 1,\n  \"rtt_config\": \"\",\n  \"async\": false\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/byteblower/run",
					"host": ["{{base_url}}"],
					"path": ["api", "byteblower", "run"]
				}
			}
		},
		{
