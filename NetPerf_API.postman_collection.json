				"method": "POST",
				"header": [{"key": "Content-Type", "value": "application/json"}],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"client_ip\": \"96.37.176.19\",\n  \"scenario\": \"US_Classic_Only\",\n  \"test_group_name\": \"TEST_SCN_RTT_0\",\n  \"iterations\": 1,\n  \"output_format\": \"json\",\n  \"platform\": \"linux\",\n  \"rtt_config\": \"\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/iperf3/run",
					"host": ["{{base_url}}"],
					"path": ["api", "iperf3", "run"]
				}
			}
		},
		{
			"name": "SpeedTest - Run Test",
			"request": {
