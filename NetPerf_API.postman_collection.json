				"header": [{"key": "Content-Type", "value": "application/json"}],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"clients\": [\"linux\", \"macos\", \"nvidia\"],\n  \"test_group_name\": \"Speedtest\",\n  \"iterations\": 1\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/speedtest/run",
					"host": ["{{base_url}}"],
					"path": ["api", "speedtest", "run"]
				}
			}
		},
